<!--
    InputDialog.xaml  -  the LAYOUT half of the InputDialog class.

    WinForms equivalent: the constructor of InputDialog.cs, where every control
    was created with "new", positioned with Location/Size and added to Controls.
    Here the same tree is described declaratively; the XAML compiler turns it into
    InputDialog.baml (embedded in the .dll) plus obj\...\InputDialog.g.cs.

    Three places where this file talks to InputDialog.xaml.cs:
      1. x:Class="WpfApp1.InputDialog"  -> links to "partial class InputDialog"
      2. x:Name="InputBox"              -> becomes a field you can use in C#
      3. Click="OnOkClicked"            -> names a method in the code-behind
-->
<Window x:Class="WpfApp1.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter a value"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FocusManager.FocusedElement="{Binding ElementName=InputBox}">

    <!-- A Grid replaces the hand-computed Location values of WinForms:
         row 0 = label + text box, row 1 = buttons. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- "_Value" makes Alt+V jump to the text box (Target). -->
        <Label Grid.Row="0" Grid.Column="0"
               Content="_Value:"
               Target="{Binding ElementName=InputBox}"
               VerticalAlignment="Center"/>

        <TextBox x:Name="InputBox"
                 Grid.Row="0" Grid.Column="1"
                 Width="275" Height="24"
                 Margin="6,0,0,0"
                 VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">

            <!-- IsDefault = Enter presses this button (WinForms: AcceptButton).
                 Click wires the event to OnOkClicked in the code-behind. -->
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="85" Height="28"
                    IsDefault="True"
                    Click="OnOkClicked"/>

            <!-- IsCancel = Escape presses this button (WinForms: CancelButton).
                 In a window opened with ShowDialog() it also sets
                 DialogResult = false and closes the window, so no C# is needed. -->
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="85" Height="28"
                    Margin="10,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
